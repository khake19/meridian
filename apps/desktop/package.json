{
  "name": "@meridian/desktop",
  "version": "0.1.0",
  "description": "Local-first case transcription desktop application",
  "author": "Meridian",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "electron-builder --dir",
    "package:windows": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4"
  },
  "build": {
    "appId": "com.meridian.desktop",
    "productName": "Meridian",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/apps/desktop-renderer",
        "to": "renderer"
      },
      {
        "from": "../../build/transcription-dist/meridian-transcription",
        "to": "transcription"
      }
    ],
    "directories": {
      "output": "../../release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
